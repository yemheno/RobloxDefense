# Normalise all text files to LF in the repo, check out as-is on Windows.
* text=auto eol=lf

# Lua source files — always LF
*.lua text eol=lf
*.luau text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.md   text eol=lf

# Binary assets — never touch line endings
*.rbxl  binary
*.rbxlx binary
*.rbxm  binary
*.rbxmx binary
